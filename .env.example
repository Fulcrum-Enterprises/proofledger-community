# ProofLedger Community. Copy to .env and fill in. Nothing here is optional unless it says so.

# Where this server is reachable from the outside. Every link the API returns starts with it.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Where the SQLite database lives (created on first start). Back this file up.
DB_PATH=./data/proofs.db

# How hashes reach Polygon. One of:
#   local   this server holds the key and sends the transaction itself
#   signer  a separate signer box holds the key (same protocol as proofledger.io's signer)
#   off     nothing is anchored; proofs stay pending. Only for trying the API.
POLYGON_ANCHORING_MODE=local

# local mode
# Any Polygon mainnet JSON-RPC endpoint. This public one answered without a key on 2026-10-20;
# a provider account (Alchemy, Infura, dRPC, QuickNode) is steadier for a busy server.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# A hex private key of a wallet holding a little POL for gas. Keep it out of git and backups you share.
POLYGON_PRIVATE_KEY=
# Optional. The address the anchoring transaction is sent to. Default: the wallet's own address
# (a self-send that carries the hash as calldata, the same shape proofledger.io writes).
# ANCHOR_TO=

# signer mode
# SIGNER_BASE_URL=http://signer.internal:8787
# SIGNER_TOKEN=

# Monthly proofs per account through the API. 0 = no limit.
PROOF_MONTHLY_CAP=0
# Calls per minute per API key.
API_KEY_LIMIT_PER_MINUTE=120
# Public verify lookups per hour per IP.
VERIFY_LIMIT_PER_HOUR=120
# Webhook delivery to partner URLs. 1 = on.
WEBHOOKS_ENABLED=1
